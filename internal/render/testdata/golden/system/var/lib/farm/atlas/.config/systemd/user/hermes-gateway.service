[Unit]
Description=Hermes gateway for atlas (snowfarm)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/var/lib/farm/atlas
Environment=HOME=/var/lib/farm/atlas
Environment=HERMES_HOME=/var/lib/farm/atlas/.hermes/profiles/atlas
Environment=HERMES_KANBAN_HOME=/srv/snowfarm/kanban
Environment=HERMES_KANBAN_WORKSPACES_ROOT=/srv/snowfarm/kanban/kanban/workspaces
Environment=HERMES_KANBAN_ATTACHMENTS_ROOT=/srv/snowfarm/kanban/kanban/attachments
Environment=HERMES_KANBAN_DISPATCH_IN_GATEWAY=false
Environment=HERMES_WRITE_SAFE_ROOT=/var/lib/farm/atlas
Environment=HERMES_MAX_ITERATIONS=120
Environment=HERMES_AGENT_TIMEOUT=1800
Environment=HERMES_REDACT_SECRETS=true
Environment=DISCORD_ALLOWED_USERS=100000000000000002
Environment=DISCORD_ALLOWED_CHANNELS=pending-reconcile
Environment=DISCORD_REQUIRE_MENTION=true
Environment=DISCORD_THREAD_REQUIRE_MENTION=true
Environment=DISCORD_ALLOW_BOTS=none
Environment=DISCORD_REPLY_TO_MODE=off
Environment=DISCORD_HISTORY_BACKFILL=false
Environment=DISCORD_ALLOW_MENTION_EVERYONE=false
Environment=DISCORD_ALLOW_MENTION_ROLES=false
Environment=DISCORD_AUTO_THREAD=true
Environment=DISCORD_COMMAND_SYNC_POLICY=off
Environment=DISCORD_HOME_CHANNEL=pending-reconcile
ExecStart=/usr/local/bin/hermes gateway run
NoNewPrivileges=true
Restart=on-failure
RestartSec=15
RestartSteps=5
RestartMaxDelaySec=120
UMask=0007
TasksMax=1024
LimitNOFILE=8192
KillMode=mixed
TimeoutStopSec=60

[Install]
WantedBy=default.target
